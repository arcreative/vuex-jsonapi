{
  "name": "vuex-jsonapi",
  "version": "0.1.0",
  "description": "jsonapi.org API layer for Vue.js applications",
  "main": "dist/vuex-jsonapi.cjs.js",
  "module": "dist/vuex-jsonapi.esm.js",
  "browser": "dist/vuex-jsonapi.umd.js",
  "exports": {
    ".": {
      "import": "./dist/vuex-jsonapi.esm.js",
      "require": "./dist/vuex-jsonapi.cjs.js"
    },
    "./pinia": {
      "import": "./dist/pinia-jsonapi.esm.js",
      "require": "./dist/pinia-jsonapi.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx rollup -c",
    "dev": "npx rollup -c -w",
    "watch": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arcreative/vuex-jsonapi.git"
  },
  "keywords": [
    "JSONAPI::Resources",
    "jsonapi",
    "jsonapi.org",
    "vue",
    "vue.js",
    "vuex",
    "api"
  ],
  "author": "Adam Robertson <adam@arcreative.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arcreative/vuex-jsonapi/issues"
  },
  "homepage": "https://github.com/arcreative/vuex-jsonapi#readme",
  "dependencies": {
    "es6-promise": "^4.2.8",
    "lodash-es": "^4.17.14",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-replace": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.5.4",
    "@babel/preset-env": "^7.5.4",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.4.4",
    "@vue/test-utils": "^2.4.0",
    "pinia": "^2.1.0",
    "rollup": "^1.16.7",
    "rollup-plugin-babel": "^4.3.3",
    "vitest": "^1.0.0",
    "vue": "^3.3.0"
  },
  "peerDependencies": {
    "pinia": "^2.0.0",
    "vue": "^3.0.0"
  }
}
